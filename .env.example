# ============================================
# House Management App — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables prefixed with VITE_ are exposed
# to the browser at build time.
# ============================================

# --- Supabase Configuration ---
# Get these from your Supabase project dashboard:
#   Project Settings → API → Project URL & anon/public key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Cloud Sync Token ---
# A shared secret used to authenticate cloud sync requests.
# Only needed if you deploy to GitHub Pages via CI.
# Set this as a GitHub Actions Secret named SYNC_TOKEN,
# it will be injected automatically during build.
VITE_SYNC_TOKEN=your-sync-token-here

# --- Base URL (optional) ---
# When deploying to a subdirectory (e.g. GitHub Pages),
# set this to the path prefix (e.g. /house/).
# Defaults to /house/ if not set.
# For local development or custom domain, set to /
VITE_BASE=/your-base-path
